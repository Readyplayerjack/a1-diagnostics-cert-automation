# Copy to .env.local (gitignored) and fill in. Local values come from `pnpm exec supabase status`.

# Supabase project URL (local default: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Anon/publishable key. Clients never touch tables (RLS has no anon policies); kept for completeness.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. SERVER ONLY. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret for per-prompt play tokens: 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PLAY_TOKEN_SECRET=
# Placeholder only; real admin auth arrives with PLAN item 10.
ADMIN_PASSWORD=change-me
